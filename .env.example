# Copy this file to .env and fill in your key. .env is git-ignored.

# Which provider serves the model: openrouter, groq, huggingface or ollama
TORA_PROVIDER=openrouter
# API key for that provider (or set OPENROUTER_API_KEY / GROQ_API_KEY / HF_TOKEN instead)
TORA_API_KEY=

# Optional settings (defaults shown)
# TORA_MODEL=openai/gpt-oss-20b          # e.g. openai/gpt-oss-120b for the bigger model
# TORA_REASONING_EFFORT=medium           # low, medium or high
# TORA_TEMPERATURE=1.0
# TORA_TOOLS=web                         # comma-separated: web, python
# TORA_PYTHON_BACKEND=docker             # docker (sandboxed) or uv (runs on this PC, trusted code only)
# TORA_SYSTEM_PROMPT=my_prompt.txt       # your own persona: the text itself, or a path to a file
# TORA_BASE_URL=                         # any other OpenAI-compatible server

# Web search (optional; page fetching works without a key). Set one:
# EXA_API_KEY=
# YDC_API_KEY=
